{
  "description": "A bolted V-slot 2020 track with four Solid V Wheel cores on a custom gantry plate. The opposed axle rows sit 20.32 mm either side of the track centerline. Integral standoffs bear on the inner rings. Two drilled T-slot feet bolt into pre- and post-assembly slot nuts in the underside of the track.",
  "steps": [
    {"caption": "Create the custom gantry plate component", "command": "component.create", "params": {"name": "Gantry plate", "activate": true}},
    {"caption": "Create the 104 x 58 x 6 mm plate", "command": "solid.box", "params": {"length": 104, "width": 58, "height": 6, "corner": [-52, -29, 31], "name": "Plate blank", "body_name": "Gantry plate"}},
    {"caption": "Round the four plan corners", "command": "solid.fillet", "params": {"body": "Gantry plate", "radius": 6, "edges": [[-52, -29, 34], [-52, 29, 34], [52, -29, 34], [52, 29, 34]], "name": "Rounded plate corners"}},
    {"caption": "Join the left_near inner-ring standoff", "command": "solid.cylinder", "params": {"radius": 4, "height": 5.5, "base": [-34, -20.32, 25.5], "operation": "join", "targets": ["Gantry plate"], "name": "Standoff left_near"}},
    {"caption": "Join the left_far inner-ring standoff", "command": "solid.cylinder", "params": {"radius": 4, "height": 5.5, "base": [-34, 20.32, 25.5], "operation": "join", "targets": ["Gantry plate"], "name": "Standoff left_far"}},
    {"caption": "Join the right_near inner-ring standoff", "command": "solid.cylinder", "params": {"radius": 4, "height": 5.5, "base": [34, -20.32, 25.5], "operation": "join", "targets": ["Gantry plate"], "name": "Standoff right_near"}},
    {"caption": "Join the right_far inner-ring standoff", "command": "solid.cylinder", "params": {"radius": 4, "height": 5.5, "base": [34, 20.32, 25.5], "operation": "join", "targets": ["Gantry plate"], "name": "Standoff right_far"}},
    {"caption": "Cut the left_near axle clearance bore", "command": "solid.cylinder", "params": {"radius": 2.75, "height": 11.5, "base": [-34, -20.32, 25.5], "operation": "cut", "targets": ["Gantry plate"], "name": "Axle bore left_near"}},
    {"caption": "Cut the left_far axle clearance bore", "command": "solid.cylinder", "params": {"radius": 2.75, "height": 11.5, "base": [-34, 20.32, 25.5], "operation": "cut", "targets": ["Gantry plate"], "name": "Axle bore left_far"}},
    {"caption": "Cut the right_near axle clearance bore", "command": "solid.cylinder", "params": {"radius": 2.75, "height": 11.5, "base": [34, -20.32, 25.5], "operation": "cut", "targets": ["Gantry plate"], "name": "Axle bore right_near"}},
    {"caption": "Cut the right_far axle clearance bore", "command": "solid.cylinder", "params": {"radius": 2.75, "height": 11.5, "base": [34, 20.32, 25.5], "operation": "cut", "targets": ["Gantry plate"], "name": "Axle bore right_far"}},
    {"caption": "Color the gantry plate", "command": "appearance.assign", "params": {"bodies": ["Gantry plate"], "color": [53, 107, 149]}},
    {"caption": "Return to the assembly root", "command": "component.activate", "params": {"component": 0}},
    {"caption": "Start Track section", "command": "sketch.create", "params": {"name": "Track section", "plane": {"origin": [-100, 0, 20], "x_dir": [0, 1, 0], "y_dir": [0, 0, 1]}}},
    {"caption": "Place track", "command": "sketch.point", "params": {"point": [0, 0], "id": "track"}},
    {"caption": "Finish Track section", "command": "sketch.finish", "params": {}},
    {"caption": "Build the 200 mm V-slot 2020 track", "command": "plugin.run", "params": {"path": "dist/techsquid-extrusions", "approval": "@approval", "entry": "make-extrusion", "params": {"slot": "V-slot", "size": "2020", "length": 200, "placement": [{"type": "external_sketch_point", "sketch": "Track section", "id": "track"}]}}},
    {"caption": "Start Foot sections", "command": "sketch.create", "params": {"name": "Foot sections", "plane": {"origin": [0, -42, 0], "x_dir": [0, 0, 1], "y_dir": [1, 0, 0]}}},
    {"caption": "Place left_foot", "command": "sketch.point", "params": {"point": [0, -80], "id": "left_foot"}},
    {"caption": "Place right_foot", "command": "sketch.point", "params": {"point": [0, 80], "id": "right_foot"}},
    {"caption": "Finish Foot sections", "command": "sketch.finish", "params": {}},
    {"caption": "Share one cross-drilled T-slot definition between two feet", "command": "plugin.run", "params": {"path": "dist/techsquid-extrusions", "approval": "@approval", "entry": "make-extrusion", "params": {"slot": "T-slot", "size": "2020", "length": 84, "holes": "42", "hole_face": "-X", "placement": [{"type": "external_sketch_point", "sketch": "Foot sections", "id": "left_foot"}, {"type": "external_sketch_point", "sketch": "Foot sections", "id": "right_foot"}]}}},
    {"caption": "Start Track underside", "command": "sketch.create", "params": {"name": "Track underside", "plane": {"origin": [0, 0, 10], "x_dir": [1, 0, 0], "y_dir": [0, -1, 0]}}},
    {"caption": "Place slide_in", "command": "sketch.point", "params": {"point": [-80, 0], "id": "slide_in"}},
    {"caption": "Place drop_in", "command": "sketch.point", "params": {"point": [80, 0], "id": "drop_in"}},
    {"caption": "Finish Track underside", "command": "sketch.finish", "params": {}},
    {"caption": "Seat the pre-assembly M5 nut under the V-slot lips", "command": "plugin.run", "params": {"path": "dist/techsquid-extrusions", "approval": "@approval", "entry": "make-t-nut", "params": {"type": "Pre-assembly", "size": "M5", "slot": "V-slot", "along": "Sketch X", "thread_modeled": false, "placement": [{"type": "external_sketch_point", "sketch": "Track underside", "id": "slide_in"}]}}},
    {"caption": "Seat the post-assembly M5 nut under the V-slot lips", "command": "plugin.run", "params": {"path": "dist/techsquid-extrusions", "approval": "@approval", "entry": "make-t-nut", "params": {"type": "Post-assembly", "size": "M5", "slot": "V-slot", "along": "Sketch X", "thread_modeled": false, "placement": [{"type": "external_sketch_point", "sketch": "Track underside", "id": "drop_in"}]}}},
    {"caption": "Start Foot screw seats", "command": "sketch.create", "params": {"name": "Foot screw seats", "plane": {"origin": [0, 0, -4], "x_dir": [1, 0, 0], "y_dir": [0, -1, 0]}}},
    {"caption": "Place left_screw", "command": "sketch.point", "params": {"point": [-80, 0], "id": "left_screw"}},
    {"caption": "Place right_screw", "command": "sketch.point", "params": {"point": [80, 0], "id": "right_screw"}},
    {"caption": "Finish Foot screw seats", "command": "sketch.finish", "params": {}},
    {"caption": "Fasten the cross-drilled feet to the track's M5 slot nuts", "command": "plugin.run", "params": {"path": "dist/techsquid-screws", "approval": "@approval", "entry": "make-screw", "params": {"size": "M5", "length": 18, "head": "Socket head", "create": "Screw only", "thread_modeled": false, "placement": [{"type": "external_sketch_point", "sketch": "Foot screw seats", "id": "left_screw"}, {"type": "external_sketch_point", "sketch": "Foot screw seats", "id": "right_screw"}]}}},
    {"caption": "Start Wheel center planes", "command": "sketch.create", "params": {"name": "Wheel center planes", "plane": "XY", "offset": 20}},
    {"caption": "Place left_near", "command": "sketch.point", "params": {"point": [-34, -20.32], "id": "left_near"}},
    {"caption": "Place left_far", "command": "sketch.point", "params": {"point": [-34, 20.32], "id": "left_far"}},
    {"caption": "Place right_near", "command": "sketch.point", "params": {"point": [34, -20.32], "id": "right_near"}},
    {"caption": "Place right_far", "command": "sketch.point", "params": {"point": [34, 20.32], "id": "right_far"}},
