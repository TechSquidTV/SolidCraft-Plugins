{
  "capabilities": [
    "commands@0.1"
  ],
  "description": "Place plain hex nuts or nylon-insert lock nuts, with optional captive pockets and bolt holes. Pick sketch points or circles, or place a loose nut at the origin.",
  "id": "techsquid-nuts",
  "name": "Hex nuts",
  "runtime": {
    "commands": [
      "appearance.assign",
      "appearance.list",
      "browser.visibility",
      "component.activate",
      "component.create",
      "component.list",
      "component.metadata",
      "component.metadata.set",
      "component.properties",
      "construct.plane.two_edges",
      "document.inspect",
      "document.metadata.set",
      "inspect.measure",
      "joint.create",
      "joint.list",
      "material.list",
      "model.body_features",
      "model.faces",
      "occurrence.copy",
      "occurrence.move",
      "occurrence.reparent",
      "parameters.list",
      "parameters.users",
      "select.set",
      "selection.get",
      "sketch.arc.three_point",
      "sketch.circle.center",
      "sketch.constraint.coincident",
      "sketch.constraint.fix",
      "sketch.constraint.horizontal_vertical",
      "sketch.create",
      "sketch.dimension",
      "sketch.edit",
      "sketch.finish",
      "sketch.inspect",
      "sketch.line",
      "sketch.polygon.circumscribed",
      "sketch.project",
      "solid.cone",
      "solid.extrude",
      "solid.hole",
      "solid.move",
      "solid.revolve",
      "timeline.group",
      "timeline.inspect"
    ],
    "entries": [
      {
        "effect": "edit",
        "input_schema": {
          "properties": {
            "create": {
              "default": "Nut only",
              "description": "Nut only builds the nut, on the origin when nothing is selected. Nut and pocket also cuts a hexagonal pocket in the part under each selected point, with a clearance hole for the bolt, and sets the nut in it flush. Pocket only cuts without a nut.",
              "enum": [
                "Nut only",
                "Nut and pocket",
                "Pocket only"
              ],
              "title": "Create",
              "type": "string"
            },
            "custom_size": {
              "description": "Optional metric thread, including a fine pitch such as M8x1. A lock nut requires a listed nominal diameter.",
              "title": "Custom size",
              "type": "string"
            },
            "custom_thickness": {
              "description": "Optional overall height, including the collar on a lock nut. Leave empty for the selected standard.",
              "maximum": 1000,
              "minimum": 0.1,
              "title": "Custom thickness",
              "type": "number",
              "unit": "mm"
            },
            "custom_width": {
              "description": "Optional width across the flats. Leave empty for the selected standard.",
              "maximum": 1000,
              "minimum": 0.1,
              "title": "Custom width",
              "type": "number",
              "unit": "mm"
            },
            "placement": {
              "description": "The sketch points or circles to put a nut on, picked in the view. Click a circle or inside it for its centre. Each gets a nut, and its pocket if Create says so. With nothing picked, one nut sits on the origin.",
              "maxItems": 32,
              "title": "Placement",
              "type": "array",
              "x-solidcraft-selection": {
                "accept": [
                  "profile",
                  "sketch_point",
                  "sketch_curve"
                ],
                "version": 1
              }
            },
            "pocket_adjust": {
              "default": 0.2,
              "description": "Used when Create cuts a pocket. Gap between each flat of the nut and the pocket. Printed pockets come out small: raise this until the nut drops in.",
              "maximum": 1,
              "minimum": 0,
              "title": "Pocket adjustment",
              "type": "number",
              "unit": "mm"
            },
            "size": {
              "default": "M3",
              "description": "Choose a coarse metric thread. Sizes marked ‘plain hex only’ require that style. Other sizes also fit nylon-insert lock nuts.",
              "oneOf": [
                {
                  "const": "M1.6",
                  "title": "M1.6 (plain hex only)"
                },
                {
                  "const": "M2",
                  "title": "M2 (plain hex only)"
                },
                {
                  "const": "M2.5"
                },
                {
                  "const": "M3"
                },
                {
                  "const": "M3.5",
                  "title": "M3.5 (plain hex only)"
                },
                {
                  "const": "M4"
                },
                {
                  "const": "M5"
                },
                {
                  "const": "M6"
                },
                {
                  "const": "M8"
                },
                {
                  "const": "M10"
                },
                {
                  "const": "M12"
                },
                {
                  "const": "M14"
                },
                {
                  "const": "M16"
                },
                {
                  "const": "M18"
                },
                {
                  "const": "M20"
                },
                {
                  "const": "M22"
                },
                {
                  "const": "M24"
                },
                {
                  "const": "M27"
                },
                {
                  "const": "M30"
                },
                {
                  "const": "M33",
                  "title": "M33 (plain hex only)"
                },
                {
                  "const": "M36",
                  "title": "M36 (plain hex only)"
                },
                {
                  "const": "M39",
                  "title": "M39 (plain hex only)"
                },
                {
                  "const": "M42",
                  "title": "M42 (plain hex only)"
                },
                {
                  "const": "M45",
                  "title": "M45 (plain hex only)"
                },
                {
                  "const": "M48",
                  "title": "M48 (plain hex only)"
                },
                {
                  "const": "M52",
                  "title": "M52 (plain hex only)"
                },
                {
                  "const": "M56",
                  "title": "M56 (plain hex only)"
                },
                {
                  "const": "M60",
                  "title": "M60 (plain hex only)"
                },
                {
                  "const": "M64",
                  "title": "M64 (plain hex only)"
                }
              ],
              "title": "Size",
              "type": "string"
            },
            "style": {
              "default": "Plain hex",
              "description": "Plain ISO 4032 hexagon nut or a thin DIN 985 nylon-insert lock nut. The nylon collar faces away from the seating surface.",
              "enum": [
                "Plain hex",
                "Nylon-insert lock nut"
              ],
              "title": "Nut style",
              "type": "string"
            },
            "thread_modeled": {
              "default": true,
              "description": "Cut the internal thread. Off leaves a cosmetic thread, which rebuilds faster.",
              "title": "Modeled thread",
              "type": "boolean"
            }
          },
          "required": [
            "style",
            "size",
            "create",
            "pocket_adjust"
          ],
          "type": "object",
          "x-solidcraft-icon": "icons/make-nut.svg"
        },
        "name": "make-nut",
        "slots": [
          {
            "kind": "menu",
            "name": "Hex nut"
          }
        ]
      }
    ],
    "limits": {
      "deadline_ms": 30000,
      "fuel": 200000000,
      "memory_mib": 64
    },
    "module": "plugin.wasm"
  },
  "version": "0.3.0"
}
