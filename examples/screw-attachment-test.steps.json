{
  "description": "Two M4 counterbored screws and two M4 tapped screws on a layout-first plate. Change the named position, recess_depth and plate_thickness parameters to exercise native screw attachments. Cosmetic threads keep edits responsive.",
  "steps": [
    {
      "command": "parameters.change",
      "params": {
        "name": "plate_length",
        "expression": "100 mm",
        "comment": "Overall length, X"
      }
    },
    {
      "command": "parameters.change",
      "params": {
        "name": "plate_width",
        "expression": "60 mm",
        "comment": "Overall width, Y"
      }
    },
    {
      "command": "parameters.change",
      "params": {
        "name": "plate_thickness",
        "expression": "12 mm",
        "comment": "Plate thickness and screw seating height"
      }
    },
    {
      "command": "parameters.change",
      "params": {
        "name": "counterbore_x",
        "expression": "25 mm",
        "comment": "Distance of the LEFT pair from the center"
      }
    },
    {
      "command": "parameters.change",
      "params": {
        "name": "counterbore_y",
        "expression": "15 mm",
        "comment": "Half the spacing of the LEFT pair"
      }
    },
    {
      "command": "parameters.change",
      "params": {
        "name": "tapped_x",
        "expression": "25 mm",
        "comment": "Distance of the RIGHT pair from the center"
      }
    },
    {
      "command": "parameters.change",
      "params": {
        "name": "tapped_y",
        "expression": "15 mm",
        "comment": "Half the spacing of the RIGHT pair"
      }
    },
    {
      "command": "parameters.change",
      "params": {
        "name": "recess_depth",
        "expression": "4 mm",
        "comment": "Counterbore depth; try 3 to 6 mm"
      }
    },
    {
      "command": "construct.plane.offset",
      "params": {
        "base": "XY",
        "offset": "plate_thickness",
        "name": "Plate top"
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": "Plate top",
        "name": "Counterbore positions"
      }
    },
    {
      "command": "sketch.point",
      "params": {
        "point": [
          "-counterbore_x",
          "counterbore_y"
        ],
        "id": "back"
      }
    },
    {
      "command": "sketch.point",
      "params": {
        "point": [
          "-counterbore_x",
          "-counterbore_y"
        ],
        "id": "front"
      }
    },
    {
      "command": "sketch.solve",
      "params": {}
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": "Plate top",
        "name": "Tapped positions"
      }
    },
    {
      "command": "sketch.point",
      "params": {
        "point": [
          "tapped_x",
          "tapped_y"
        ],
        "id": "back"
      }
    },
    {
      "command": "sketch.point",
      "params": {
        "point": [
          "tapped_x",
          "-tapped_y"
        ],
        "id": "front"
      }
    },
    {
      "command": "sketch.solve",
      "params": {}
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.box",
      "params": {
        "length": "plate_length",
        "width": "plate_width",
        "height": "plate_thickness",
        "center": [
          0,
          0,
          "plate_thickness / 2"
        ],
        "operation": "new",
        "body_name": "Test plate",
        "name": "Test plate blank"
      }
    },
    {
      "command": "solid.fillet",
      "params": {
        "body": "Test plate",
        "edges": [
          [
            50,
            30,
            6
          ],
          [
            -50,
            30,
            6
          ],
          [
            -50,
            -30,
            6
          ],
          [
            50,
            -30,
            6
          ]
        ],
        "radius": 3,
        "name": "Rounded plate corners"
      }
    },
    {
      "command": "plugin.run",
      "params": {
        "path": "dist/techsquid-screws",
        "approval": "@approval",
        "entry": "make-screw",
        "params": {
          "size": "M4",
          "head": "Socket head",
          "create": "Screw and hole",
          "thread_modeled": false,
          "length": 6,
          "hole_type": "Clearance, head recessed",
          "placement": [
            {
              "type": "external_sketch_point",
              "sketch": "Counterbore positions",
              "id": "back"
            },
            {
              "type": "external_sketch_point",
              "sketch": "Counterbore positions",
              "id": "front"
            }
          ]
        }
      }
    },
    {
      "command": "timeline.edit",
      "params": {
        "feature": "Counterbore M4",
        "set": {
          "hole.cb_depth": "recess_depth",
          "depth": "plate_thickness"
        }
      }
    },
    {
      "command": "plugin.run",
      "params": {
        "path": "dist/techsquid-screws",
        "approval": "@approval",
        "entry": "make-screw",
        "params": {
          "size": "M4",
          "head": "Socket head",
          "create": "Screw and hole",
          "thread_modeled": false,
          "length": 8,
          "hole_type": "Tapped",
          "placement": [
            {
              "type": "external_sketch_point",
              "sketch": "Tapped positions",
              "id": "back"
            },
            {
              "type": "external_sketch_point",
              "sketch": "Tapped positions",
              "id": "front"
            }
          ]
        }
      }
    },
    {
      "command": "timeline.edit",
      "params": {
        "feature": "Tapped hole M4",
        "set": {
          "depth": "plate_thickness"
        }
      }
    },
    {
      "command": "appearance.assign",
      "params": {
        "bodies": [
          "Test plate"
        ],
        "color": "#92A7B8"
      }
    },
    {
      "command": "appearance.assign",
      "params": {
        "bodies": [
          "Screw M4 x 6 socket"
        ],
        "color": "#DA9D38"
      }
    },
    {
      "command": "appearance.assign",
      "params": {
        "bodies": [
          "Screw M4 x 8 socket"
        ],
        "color": "#54B6A9"
      }
    }
  ],
