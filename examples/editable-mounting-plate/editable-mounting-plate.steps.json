{
  "description": "One mounting plate with four layout-first M4 screws and two M6 captive nuts. Edit the layout, plate thickness, recess depth and nut pocket depths; all six seat joints follow.",
  "steps": [
    {"command": "parameters.change", "params": {"name": "plate_length", "expression": "100 mm", "comment": "Overall length, X"}},
    {"command": "parameters.change", "params": {"name": "plate_width", "expression": "60 mm", "comment": "Overall width, Y"}},
    {"command": "parameters.change", "params": {"name": "plate_thickness", "expression": "12 mm", "comment": "Plate thickness and screw seating height"}},
    {"command": "parameters.change", "params": {"name": "counterbore_x", "expression": "25 mm", "comment": "Distance of the LEFT pair from the center"}},
    {"command": "parameters.change", "params": {"name": "counterbore_y", "expression": "15 mm", "comment": "Half the spacing of the LEFT pair"}},
    {"command": "parameters.change", "params": {"name": "tapped_x", "expression": "25 mm", "comment": "Distance of the RIGHT pair from the center"}},
    {"command": "parameters.change", "params": {"name": "tapped_y", "expression": "15 mm", "comment": "Half the spacing of the RIGHT pair"}},
    {"command": "parameters.change", "params": {"name": "recess_depth", "expression": "4 mm", "comment": "Counterbore depth; try 3 to 6 mm"}},
    {"command": "construct.plane.offset", "params": {"base": "XY", "offset": "plate_thickness", "name": "Plate top"}},
    {"command": "sketch.create", "params": {"plane": "Plate top", "name": "Counterbore positions"}},
    {"command": "sketch.point", "params": {"point": ["-counterbore_x", "counterbore_y"], "id": "back"}},
    {"command": "sketch.point", "params": {"point": ["-counterbore_x", "-counterbore_y"], "id": "front"}},
    {"command": "sketch.solve", "params": {}},
    {"command": "sketch.finish", "params": {}},
    {"command": "sketch.create", "params": {"plane": "Plate top", "name": "Tapped positions"}},
    {"command": "sketch.point", "params": {"point": ["tapped_x", "tapped_y"], "id": "back"}},
    {"command": "sketch.point", "params": {"point": ["tapped_x", "-tapped_y"], "id": "front"}},
    {"command": "sketch.solve", "params": {}},
    {"command": "sketch.finish", "params": {}},
    {"command": "solid.box", "params": {"length": "plate_length", "width": "plate_width", "height": "plate_thickness", "center": [0, 0, "plate_thickness / 2"], "operation": "new", "body_name": "Mounting plate", "name": "Mounting plate blank"}},
    {"command": "solid.fillet", "params": {"body": "Mounting plate", "edges": [[50, 30, 6], [-50, 30, 6], [-50, -30, 6], [50, -30, 6]], "radius": 3, "name": "Rounded plate corners"}},
    {"command": "plugin.run", "params": {"path": "dist/techsquid-screws", "approval": "@approval", "entry": "make-screw", "params": {"size": "M4", "head": "Socket head", "create": "Screw and hole", "thread_modeled": false, "length": 6, "hole_type": "Clearance, head recessed", "placement": [{"type": "external_sketch_point", "sketch": "Counterbore positions", "id": "back"}, {"type": "external_sketch_point", "sketch": "Counterbore positions", "id": "front"}]}}},
    {"command": "timeline.edit", "params": {"feature": "Counterbore M4", "set": {"hole.cb_depth": "recess_depth", "depth": "plate_thickness"}}},
    {"command": "plugin.run", "params": {"path": "dist/techsquid-screws", "approval": "@approval", "entry": "make-screw", "params": {"size": "M4", "head": "Socket head", "create": "Screw and hole", "thread_modeled": false, "length": 8, "hole_type": "Tapped", "placement": [{"type": "external_sketch_point", "sketch": "Tapped positions", "id": "back"}, {"type": "external_sketch_point", "sketch": "Tapped positions", "id": "front"}]}}},
    {"command": "timeline.edit", "params": {"feature": "Tapped hole M4", "set": {"depth": "plate_thickness"}}},
    {"command": "appearance.assign", "params": {"bodies": ["Mounting plate"], "color": "#92A7B8"}},
    {"command": "appearance.assign", "params": {"bodies": ["Screw M4 x 6 socket"], "color": "#DA9D38"}},
    {"command": "appearance.assign", "params": {"bodies": ["Screw M4 x 8 socket"], "color": "#54B6A9"}},
    {"caption": "Lay out the nut centers on the top of the plate", "command": "sketch.create", "params": {"plane": "Plate top", "name": "Nut centers"}},
    {"caption": "The left nut uses a standalone sketch point", "command": "sketch.point", "params": {"point": [-14, 0], "id": "left"}},
    {"caption": "The right nut uses a circle center", "command": "sketch.circle.center", "params": {"center": [14, 0], "radius": 2, "id": "right"}},
    {"caption": "Finish the layout", "command": "sketch.finish", "params": {}},
    {"caption": "Cut both pockets and bolt holes, and seat two nuts", "command": "plugin.run", "params": {"path": "dist/techsquid-nuts", "approval": "@approval", "entry": "make-nut", "params": {"size": "M6", "create": "Nut and pocket", "thread_modeled": false, "placement": [{"type": "external_sketch_point", "sketch": "Nut centers", "id": "left"}, {"type": "external_sketch_curve", "sketch": "Nut centers", "id": "right"}]}}},
    {"caption": "Name the left pocket for its later depth edit", "command": "timeline.rename", "params": {"feature": "Nut pocket M6", "name": "Left nut pocket"}},
    {"caption": "Set an editable depth for the left pocket", "command": "parameters.change", "params": {"name": "left_pocket_depth", "expression": "5.2 mm"}},
    {"caption": "Drive the left pocket depth from that parameter", "command": "timeline.edit", "params": {"feature": "Left nut pocket", "set": {"extent.distance": "left_pocket_depth"}}},
    {"command": "parameters.change", "caption": "Edit counterbore x", "params": {"name": "counterbore_x", "expression": "32 mm"}},
    {"command": "parameters.change", "caption": "Edit counterbore y", "params": {"name": "counterbore_y", "expression": "18 mm"}},
    {"command": "parameters.change", "caption": "Edit tapped x", "params": {"name": "tapped_x", "expression": "18 mm"}},
    {"command": "parameters.change", "caption": "Edit tapped y", "params": {"name": "tapped_y", "expression": "20 mm"}},
    {"command": "parameters.change", "caption": "Edit recess depth", "params": {"name": "recess_depth", "expression": "6 mm"}},
    {"command": "parameters.change", "caption": "Edit plate thickness", "params": {"name": "plate_thickness", "expression": "14 mm"}},
    {"caption": "Edit the source layout; the nuts, pockets and bolt holes share these centers", "command": "sketch.edit", "params": {"sketch": "Nut centers"}},
    {"caption": "Move the left center from -14 to -22 mm", "command": "sketch.move_point", "params": {"point": "left", "to": [-22, 0]}},
    {"caption": "Move the right circle center from 14 to 22 mm", "command": "sketch.move_point", "params": {"point": "right.center", "to": [22, 0]}},
    {"caption": "Finish the sketch: both nuts and both cuts move apart together", "command": "sketch.finish", "params": {}},
    {"caption": "Deepen only the left pocket from 5.2 to 8 mm; its nut follows the floor", "command": "parameters.change", "params": {"name": "left_pocket_depth", "expression": "8 mm"}},
    {"command": "appearance.assign", "caption": "Color the M6 nuts amber", "params": {"bodies": ["Nut M6"], "color": "#D7AF57"}}
  ],
